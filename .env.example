# Guard MCP server — environment template
#
# Copy this file to `.env` and fill in your values:
#
#     cp .env.example .env
#
# `.env` is git-ignored so your secrets never leave your machine. This file is
# committed, so it must only ever contain placeholders — never a real key.
#
# Variables come in two families:
#
#   GUARD_*         read by the Guard client (which API, which account, which engine)
#   GUARD_MCP_*     read by this server (which transport, which files, which limits)
#

# (REQUIRED) API key
GUARD_API_KEY=

# (REQUIRED) Default space the media will be processed in
GUARD_SPACE_ID=

# (OPTIONAL) Default organization which owns new spaces, and scopes runner listings
#GUARD_ORGANIZATION_ID=

# (OPTIONAL) API root
#GUARD_BASE_URL=https://api.elhio.com

# (OPTIONAL) Engine used, either "cloud" or "local"
#GUARD_ENGINE=cloud

# (OPTIONAL) Language
#GUARD_LOCALE=en

# (OPTIONAL) Per-request HTTP timeout, in seconds
#GUARD_TIMEOUT=30.0

# (OPTIONAL) Retries on connection errors and 429/5xx responses
#GUARD_MAX_RETRIES=3

# (OPTIONAL) Path to the ONNX model for the local engine
#GUARD_LOCAL_MODEL_PATH=

# (OPTIONAL) Read a different env file instead of `.env`
#GUARD_ENV_FILE=.env.staging

# (OPTIONAL) Transport used, either "stdio" or "http"
#GUARD_MCP_TRANSPORT=stdio
#GUARD_MCP_HOST=127.0.0.1
#GUARD_MCP_PORT=8000

# (OPTIONAL) Directories media may be read from, defaults to working directory of the server process
# Several are separated the way PATH is on your platform: ":" on macOS and Linux, ";" on Windows
#GUARD_MCP_MEDIA_ROOTS=/Users/me/Pictures:/srv/uploads

# (OPTIONAL) Turn the directory check off entirely
#GUARD_MCP_ALLOW_ANY_PATH=false

# (OPTIONAL) Largest accepted file, in bytes. Default 100 MB.
#GUARD_MCP_MAX_MEDIA_BYTES=104857600

# (OPTIONAL) How long analyze_media waits for cloud processing, in seconds
#GUARD_MCP_DEFAULT_POLL_TIMEOUT=90.0
#GUARD_MCP_MAX_POLL_TIMEOUT=600.0

# (OPTIONAL) Rate limits, first two cover every MCP message and third is tighter budget for billable activities
#GUARD_MCP_MAX_REQUESTS_PER_SECOND=10.0
#GUARD_MCP_BURST_CAPACITY=20
#GUARD_MCP_ACTIVITY_REQUESTS_PER_MINUTE=30.0

# (OPTIONAL) Log tool arguments and results
#GUARD_MCP_INCLUDE_PAYLOADS_IN_LOGS=false
#GUARD_MCP_MAX_PAYLOAD_LOG_LENGTH=1000
#GUARD_MCP_LOG_LEVEL=INFO

# (OPTIONAL) Run analyze_media as a background task
#GUARD_MCP_ENABLE_TASKS=true

# (OPTIONAL) Task backend. "memory://" keeps state in the server process, which is
# right for stdio. Use Redis for an HTTP deployment with more than one worker,
# otherwise a task started on one worker is invisible to the next request.
#GUARD_MCP_DOCKET_URL=memory://
#GUARD_MCP_DOCKET_NAME=fastmcp
#GUARD_MCP_DOCKET_CONCURRENCY=10
